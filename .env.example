# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (Default to SQLite for local dev, uncomment for Oracle)
CUSTOM_DATABASE_URL=sqlite:///./dev.db
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=XE
# ORACLE_USER=system
# ORACLE_PASSWORD=oracle

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENCRYPTION_KEY=change_this_to_a_secure_random_string_in_production

# LLM Configuration
LLM_PROVIDER=mistral_3b
LLM_MODEL_PATH=./models/mistral-7b-quantized.gguf
LLM_QUANTIZATION=4bit
LLM_CONTEXT_LENGTH=4096

# Vector Search
VECTOR_INDEX_TYPE=milvus
INDEX_STORAGE_PATH=./data/vector_index
VECTOR_DIMENSION=384

# Document Processing
ENABLE_OCR=true
INGESTION_WORKERS=2
